# Copy this file to .env for local overrides.
# DO NOT commit .env to version control.
#
# Vite inlines any VITE_* variable into the public JavaScript bundle.
# Do not put secrets here. The debug panel is development-only and
# does not use a production key.

# Optional: override the geocoding proxy (defaults to /api/geocoding,
# which Vite proxies in dev and Netlify serves in production).
# VITE_GEOCODING_PROXY_URL=

# VITE_APP_VERSION=1.0.0
